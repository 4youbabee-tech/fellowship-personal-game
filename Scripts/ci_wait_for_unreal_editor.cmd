@echo off
setlocal EnableExtensions
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$deadline=(Get-Date).AddMinutes(20); $observedBefore=Get-Date; $projectPath=Join-Path $env:GITHUB_WORKSPACE 'ShireJourney.uproject'; $currentOwner=[System.Security.Principal.WindowsIdentity]::GetCurrent().Name; $findEditors={ Get-Process -Name UE4Editor,UE4Editor-Cmd -ErrorAction SilentlyContinue }; $editors=@(&$findEditors); while($editors.Length -gt 0){$reclaimed=$false; foreach($editor in $editors){if($editor.ProcessName -ne 'UE4Editor-Cmd'){continue}; try{$candidate=Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $editor.Id) -ErrorAction Stop; if(-not $candidate){continue}; $parent=Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $candidate.ParentProcessId) -ErrorAction SilentlyContinue; $ownerResult=Invoke-CimMethod -InputObject $candidate -MethodName GetOwner -ErrorAction Stop; $owner=if($ownerResult.ReturnValue -eq 0){$ownerResult.Domain + '\' + $ownerResult.User}else{''}; $created=[Management.ManagementDateTimeConverter]::ToDateTime($candidate.CreationDate); $engineMatch=$candidate.ExecutablePath -match '(?i)\\UE_4\.27\\Engine\\Binaries\\Win64\\UE4Editor-Cmd\.exe$'; $line=[string]$candidate.CommandLine; $projectMatch=$line.IndexOf($projectPath,[StringComparison]::OrdinalIgnoreCase) -ge 0; $ciFlags=$line -match '(?i)(?:^|\s)-run=[^\s]+' -and $line -match '(?i)(?:^|\s)-unattended(?:\s|$)'; $orphanCiCommandlet=$engineMatch -and $projectMatch -and $ciFlags -and (-not $parent) -and ($owner -ieq $currentOwner) -and ($created -lt $observedBefore); if($orphanCiCommandlet){Write-Warning ('Releasing verified orphan CI commandlet PID=' + $editor.Id + ' parentPID=' + $candidate.ParentProcessId + ' owner=' + $owner + ' command=' + $line); Stop-Process -Id $editor.Id -Force -ErrorAction Stop; $reclaimed=$true; break}else{Write-Host ('UNREAL_PROCESS_DIAGNOSTIC name=' + $editor.ProcessName + ' pid=' + $editor.Id + ' parentPID=' + $candidate.ParentProcessId + ' parentPresent=' + [bool]$parent + ' owner=' + $owner + ' engineMatch=' + $engineMatch + ' projectMatch=' + $projectMatch + ' ciFlags=' + $ciFlags + ' command=' + $line)}}catch{Write-Warning ('Could not safely classify Unreal commandlet PID=' + $editor.Id + '; leaving it untouched. ' + $_.Exception.Message)}}; if($reclaimed){Start-Sleep -Seconds 2;$editors=@(&$findEditors);continue}; $names=($editors | ForEach-Object { '{0}(PID {1})' -f $_.ProcessName,$_.Id }) -join ', '; if((Get-Date)-ge $deadline){Write-Error ('Unreal editor processes stayed open for 20 minutes: ' + $names + '. No user editor was terminated.');exit 40}; Write-Host ('Unreal editor process(es) remain active: ' + $names + '; waiting 10 seconds without terminating them.');Start-Sleep -Seconds 10;$editors=@(&$findEditors)};Write-Host 'All UE4Editor and UE4Editor-Cmd processes are closed. Validation may continue.'"
set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" exit /b %RC%
exit /b 0
