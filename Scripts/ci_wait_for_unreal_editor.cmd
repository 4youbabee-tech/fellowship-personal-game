@echo off
setlocal EnableExtensions
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$observedBefore=Get-Date; $projectPath=Join-Path $env:GITHUB_WORKSPACE 'ShireJourney.uproject'; $currentOwner=[System.Security.Principal.WindowsIdentity]::GetCurrent().Name; $editors=@(Get-Process -Name UE4Editor,UE4Editor-Cmd -ErrorAction SilentlyContinue); $reclaimed=$false; foreach($editor in $editors){if($editor.ProcessName -ne 'UE4Editor-Cmd'){Write-Error ('Interactive Unreal Editor is already running: PID ' + $editor.Id + '. Failing immediately without terminating it.');exit 40}; try{$candidate=Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $editor.Id) -ErrorAction Stop; if(-not $candidate){continue}; $parent=Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $candidate.ParentProcessId) -ErrorAction SilentlyContinue; $ownerResult=Invoke-CimMethod -InputObject $candidate -MethodName GetOwner -ErrorAction Stop; $owner=if($ownerResult.ReturnValue -eq 0){$ownerResult.Domain + '\' + $ownerResult.User}else{''}; $created=$editor.StartTime; $engineMatch=$candidate.ExecutablePath -match '(?i)\\UE_4\.27\\Engine\\Binaries\\Win64\\UE4Editor-Cmd\.exe$'; $line=[string]$candidate.CommandLine; $projectMatch=$line.IndexOf($projectPath,[StringComparison]::OrdinalIgnoreCase) -ge 0; $ciFlags=$line -match '(?i)(?:^|\s)-run=[^\s]+' -and $line -match '(?i)(?:^|\s)-unattended(?:\s|$)'; $orphanCiCommandlet=$engineMatch -and $projectMatch -and $ciFlags -and (-not $parent) -and ($owner -ieq $currentOwner) -and ($created -lt $observedBefore); if($orphanCiCommandlet){Write-Warning ('Releasing verified orphan CI commandlet PID=' + $editor.Id + ' parentPID=' + $candidate.ParentProcessId + ' owner=' + $owner + ' command=' + $line); Stop-Process -Id $editor.Id -Force -ErrorAction Stop; $reclaimed=$true}else{Write-Error ('UNREAL_PROCESS_DIAGNOSTIC name=' + $editor.ProcessName + ' pid=' + $editor.Id + ' parentPID=' + $candidate.ParentProcessId + ' parentPresent=' + [bool]$parent + ' owner=' + $owner + ' engineMatch=' + $engineMatch + ' projectMatch=' + $projectMatch + ' ciFlags=' + $ciFlags + ' command=' + $line + '. Failing immediately; process was not terminated.');exit 40}}catch{Write-Error ('Could not safely classify Unreal commandlet PID=' + $editor.Id + '; failing immediately and leaving it untouched. ' + $_.Exception.Message);exit 40}}; if($reclaimed){Start-Sleep -Seconds 1}; $remaining=@(Get-Process -Name UE4Editor,UE4Editor-Cmd -ErrorAction SilentlyContinue); if($remaining.Length -gt 0){$names=($remaining | ForEach-Object {'{0}(PID {1})' -f $_.ProcessName,$_.Id}) -join ', '; Write-Error ('Unreal editor process remains after one safe check: ' + $names + '. Failing immediately; no unverified process was terminated.');exit 40}; Write-Host 'All UE4Editor and UE4Editor-Cmd processes are closed. Validation may continue.'"
set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" exit /b %RC%
exit /b 0
