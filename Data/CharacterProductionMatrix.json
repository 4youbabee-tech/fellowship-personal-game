{
  "schema_version": 1,
  "matrix_id": "PART1_CHARACTER_PRODUCTION_MATRIX_V1",
  "status": "PROJECT_OWNED_MODULAR_FOUNDATIONS_ACTIVE_FINAL_RIGS_MATERIALS_PENDING",
  "target": "Replace recognizable proxy/modular stand-ins with production characters while preserving UE4.27.2 performance and each character's instantly readable silhouette.",
  "sourcing_policy": {
    "preferred_order": [
      "project-owned or self-authored character base",
      "explicitly permitted free/personal-use asset with captured source and terms",
      "licensed marketplace asset",
      "procedural/custom character creation from legally usable base parts"
    ],
    "rule": "Free availability is not treated as permission by itself. Record source URL/provider, terms snapshot/date, allowed use and modification status before integrating an external model.",
    "private_project_context": "The project is private/personal, but provenance is still recorded so future use does not silently exceed the asset's terms.",
    "likeness_rule": "Use film-context silhouette, wardrobe, age and role cues; do not depend on an exact unauthorized scan or actor likeness to make the character recognizable."
  },
  "common_pipeline": [
    "select/source legal base mesh",
    "clean topology and scale",
    "author/adjust face hair clothing and equipment",
    "UV/material pass",
    "UE4 humanoid-compatible skeleton where practical",
    "skin weights and deformation audit",
    "retarget locomotion/action animations",
    "Animation Blueprint integration",
    "weapon/prop sockets",
    "collision and gameplay hooks",
    "LOD/culling/material-instance optimization",
    "UE4 import/compile/startup validation",
    "PIE visual and motion acceptance"
  ],
  "performance_contract": {
    "target": "720p Low-Medium / 30 FPS floor",
    "principles": [
      "hero characters receive selective near-camera detail",
      "secondary characters use cheaper materials and LODs",
      "crowds reuse skeleton/material families where visually safe",
      "hair/cloth simulation is bounded and optional on low settings",
      "no character is called final from a static mesh or proxy silhouette alone"
    ]
  },
