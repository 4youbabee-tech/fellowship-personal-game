{
  "schema_version": 1,
  "plan_id": "PART1_LIVING_WORLD_EVENT_CONTRACT_V1",
  "purpose": "Low-cost environmental life/micro-event contract for Part I traversal. Defines authored event categories, eligibility, density and performance caps; runtime spawning is separate.",
  "status_values": [
    "PLANNED",
    "DATA_DEFINED",
    "RUNTIME_PARTIAL",
    "RUNTIME_VALIDATED"
  ],
  "event_types": [
    "WORK_ACTIVITY",
    "TRAVELER_PASSING",
    "MARKET_ACTIVITY",
    "SOCIAL_MOMENT",
    "FAUNA",
    "WEATHER_REACTION",
    "PROP_MOTION",
    "DANGER_REACTION",
    "STORY_AFTERMATH"
  ],
  "region_budgets": {
    "max_active_micro_events_near_player": 3,
    "max_active_fauna_groups_near_player": 2,
    "max_persistent_micro_event_actors": 0,
    "min_seconds_between_event_starts": 12,
    "event_cull_distance_cm": 5000,
    "fauna_cull_distance_cm": 4200,
    "offscreen_simulation": "STATE_ONLY"
  },
  "rules": [
    "Micro-events never block main story progression.",
    "Story-critical interactions preempt ambient micro-events.",
    "Events must match current region, chapter and story state.",
    "Ambient actors/events are disposable and must not require persistent transforms.",
    "Use pooled/instanced/lightweight presentation where possible.",
    "Fauna and prop motion are optional under performance pressure.",
    "Danger chapters may suppress peaceful events.",
    "Event selection should avoid repeating the same event type back-to-back when alternatives exist.",
    "CP55 fauna uses project-owned low-poly bird/rabbit/butterfly meshes and distance-throttled ambient actors; no new persistent AI state."
  ],
  "chapter_contracts": [
