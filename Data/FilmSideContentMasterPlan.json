{
  "schema_version": 1,
  "plan_id": "FILM_SIDE_CONTENT_MASTER_V1",
  "status": "ACCEPTED_AUDITED_MASTER_PLAN",
  "authority_order": [
    "Verified Peter Jackson film/script continuity",
    "Existing Story Canon Bible / FilmExperiencePlan",
    "FILM_MOMENT gameplay conversion",
    "FILM_EXPANDED story-safe life around the scene",
    "CHRONICLE content clearly separated from film canon"
  ],
  "taxonomy": {
    "FILM_MOMENT": "An event actually present in the chosen film continuity; gameplay may replace/pass through the cutscene but outcome stays fixed.",
    "FILM_EXPANDED": "The film scene/place exists; game adds plausible local play before/after it without changing scene order, participants or outcome.",
    "CHRONICLE": "Book-only, historical or character-past material kept visibly separate from Main Film Canon. It cannot silently become the film timeline."
  },
  "global_guards": [
    "No side activity may cancel, avoid or change a mandatory film event.",
    "A player choice may alter banter, reward, route detail, preparation or presentation, not the canonical result.",
    "When a FILM_MOMENT already exists, prefer making that moment playable before inventing unrelated filler.",
    "Urgent canon beats close or suspend side content.",
    "CHRONICLE content must be labeled and separated from Film Main Story.",
    "No book-only event may be inserted into Film Main Story merely because it is popular."
  ],
  "audits_and_corrections": [
    {
      "issue": "Fellowship opening described as starting at Bilbo's birthday party",
      "correction": "The film/script opening includes the Ring prologue and Bilbo writing before the party sequence. Party content is early-game material, not the literal first scene."
    },
    {
      "issue": "Weathertop fire treated as a player choice that could change detection",
      "correction": "The canonical attack must still happen. Fire/visibility interaction may change tension, dialogue or stealth presentation only."
    },
    {
      "issue": "Prancing Pony Attention Meter could imply the Ring incident is avoidable",
      "correction": "Attention may alter ambient suspicion or difficulty, but the canonical Ring incident/Strider/Nazgul progression remains mandatory."
    },
    {
      "issue": "Doors of Moria as an unrestricted puzzle",
      "correction": "Use a guided canonical puzzle: the player may perform reasoning/interactions, but the required door solution/outcome cannot branch."
    },
    {
      "issue": "Entmoot evidence-gathering could change the film's causal chain",
      "correction": "Do not let the player replace the film's decision causality. Any Fangorn exploration/evidence is contextual only; Treebeard's film decision path remains fixed."
    },
    {
      "issue": "Oliphaunt observation grants a future combat weakness",
      "correction": "Keep it as Lore/Perception/Chronicle or local tactical observation, not a cross-film power-up that rewrites later combat."
    },
    {
      "issue": "Lighting the Beacons framed as a generic relay time-trial",
      "correction": "The verified Return of the King screenplay specifically supports Pippin reaching and lighting the Minas Tirith beacon while Gandalf waits below. Use that as the playable FILM_MOMENT; subsequent mountain beacons remain the film montage unless separately source-verified."
    },
    {
      "issue": "Scouring of the Shire proposed as post-game continuation",
      "correction": "It is book-only and omitted from the film continuity. If ever used, it must remain a clearly labeled CHRONICLE/alternate book campaign, not the film ending."
    },
    {
      "issue": "Glorfindel at the Ford",
      "correction": "Book-only Chronicle. Film Main Story keeps Arwen in the rescue role."
    }
  ],
