{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Data/ProjectGovernor.schema.json",
  "title": "Fellowship Project Governor",
  "type": "object",
  "required": [
    "schema_version",
    "authority_id",
    "authority_rule",
    "repository",
    "active_branch",
    "requirements",
    "decisions",
    "work_queue",
    "active_gate",
    "update_protocol",
    "worker_contract",
    "governor_role",
    "branch_workflow",
    "request_capture_contract",
    "external_review_findings"
  ],
  "properties": {
    "authority_id": {
      "const": "FELLOWSHIP_SINGLE_PROJECT_GOVERNOR_V2"
    },
    "active_branch": {
      "const": "develop"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "priority",
          "status",
          "origin",
          "intent",
          "acceptance_criteria",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "status": {
            "enum": [
              "REQUESTED",
              "PLANNED",
              "PARTIAL",
              "IMPLEMENTED",
              "VALIDATED",
              "DEFERRED",
              "REJECTED",
              "SUPERSEDED"
            ]
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "owner_intent": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "request_capture_contract": {
      "type": "object",
      "required": [
        "important_request_definition",
        "capture_rule",
        "external_advice_rule",
        "anti_loss_rule",
        "coordination_rule"
      ]
    },
    "external_review_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "verification_sha",
          "verification_status",
          "claim",
          "verified_result",
          "disposition",
          "linked_requirements",
          "linked_work",
          "next_action"
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
