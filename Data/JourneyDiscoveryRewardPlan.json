{
  "schema_version": 1,
  "plan_id": "JOURNEY_DISCOVERY_REWARD_SYSTEM_V1",
  "status": "RUNTIME_STATE_TRIGGERS_SAVE_HUD_IMPLEMENTED_PENDING_ENGINE_PROOF",
  "inspiration_note": "Uses the satisfying idea of rewarding first-time place discovery common to exploration RPGs, but the presentation and rewards are original and fitted to this project's film-spine world.",
  "purpose": "Make exploration feel like game progression, not empty wandering, while keeping mandatory film chronology intact.",
  "player_facing_name": "Journey Discoveries",
  "currency_name": "Journey Insight",
  "presentation": {
    "discovery_toast": "Discovered: <place or memory>",
    "secondary_line": "Journey Insight +<amount>",
    "style": "brief, quiet, diegetic-adjacent; no giant arcade banner during emotional or cinematic moments",
    "cinematic_behavior": "queue the toast until player control returns if discovery occurs during a locked cinematic",
    "repeat_behavior": "no repeat Insight for the same discovery; revisits may still trigger ambient/dialogue reactions"
  },
  "reward_philosophy": [
    "Reward curiosity without turning Frodo or other characters into stat-inflated superheroes.",
    "Prefer knowledge, map memory, dialogue, companion memory and navigation quality-of-life over raw combat power.",
    "Exploration rewards may enrich play but never skip a mandatory story beat or change a fixed film outcome.",
    "Discoveries must remain useful even when the player ignores completionism."
  ],
  "categories": {
    "ROAD_WISDOM": {
      "description": "Paths, crossings, viewpoints and route understanding.",
      "primary_unlocks": [
        "MAP_MEMORY",
        "RETURN_ROUTE_HINT"
      ]
    },
    "PEOPLES_AND_PLACES": {
      "description": "Culture, craft, history and regional identity.",
      "primary_unlocks": [
        "CHRONICLE_ENTRY",
        "LORE_DIALOGUE_TOPIC"
      ]
    },
    "FELLOWSHIP_BONDS": {
      "description": "Shared moments, camp life and companion memories.",
      "primary_unlocks": [
        "COMPANION_MEMORY_TOPIC",
        "CONTEXTUAL_BANTER"
      ]
    },
    "PERIL_SENSE": {
      "description": "Threat signs, dangerous terrain and survival knowledge.",
      "primary_unlocks": [
        "LOCAL_HAZARD_NOTE",
        "CONTEXTUAL_WARNING"
      ]
    }
  },
  "journey_insight_milestones": [
    {
      "threshold": 40,
      "id": "WAYFARER_I",
      "reward": "Known discoveries can provide a subtle return-to-route hint inside the current exploration envelope.",
      "power_type": "QUALITY_OF_LIFE"
    },
    {
      "threshold": 90,
      "id": "LISTENER_I",
      "reward": "Discovered places may unlock extra bounded conversation topics with characters who plausibly know them.",
      "power_type": "CONTENT"
    },
    {
      "threshold": 150,
      "id": "LOREKEEPER_I",
      "reward": "Chronicle entries gain an expanded contextual note and can seed later companion remarks.",
      "power_type": "CONTENT"
    },
    {
      "threshold": 220,
      "id": "ROADWISE_I",
      "reward": "Previously explored regions may show one extra subtle navigation cue toward known safe landmarks, never across a locked story gate.",
      "power_type": "QUALITY_OF_LIFE"
    }
  ],
