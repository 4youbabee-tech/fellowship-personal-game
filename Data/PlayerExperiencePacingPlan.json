{
  "schema_version": 1,
  "plan_id": "PART1_PLAYER_EXPERIENCE_PACING_V1",
  "purpose": "Human-review contract for clarity, rhythm, repetition, exploration reward and frustration. These are review targets, not automatic claims that a chapter is fun.",
  "review_status_values": [
    "NOT_REVIEWED",
    "ISSUES_FOUND",
    "TUNING",
    "ACCEPTED"
  ],
  "dimensions": [
    "OBJECTIVE_CLARITY",
    "TRAVEL_RHYTHM",
    "DISCOVERY_DENSITY",
    "DIALOGUE_RHYTHM",
    "COMBAT_RHYTHM",
    "REPETITION",
    "WAITING_FRICTION",
    "FAILURE_FRICTION",
    "STORY_MOMENT_WEIGHT"
  ],
  "global_review_rules": [
    "PACING cannot be marked ACCEPTED by static CI or compile success.",
    "Flag long empty traversal when there is no story tension, vista, ambience change, interaction or discovery carrying the section.",
    "Do not add activity merely to fill space; quiet sections may be intentional when they support emotion or suspense.",
    "Main objectives must remain understandable without excessive HUD spam.",
    "Repeated dialogue, micro-events and combat patterns require cooldown/variation rather than higher quantity.",
    "Failure/retry must not force excessive replay of non-challenging travel or dialogue.",
    "Film story anchors receive enough time and presentation weight to remain emotionally readable."
  ],
