  "status": "ACTIVE_CLOUD_SOURCE_PREP_SELF_HOSTED_RUNTIME_LOCKED",
  "created_on": "2026-10-11",
  "authority": [
    "Data/ProjectGovernor.json#owner_fast_batch_intake_policy_2026_10_11",
    "Data/MaximumSafeProductionModeV1.json#owner_offline_fast_production_2026_10_11",
    "Data/OfflineFastProductionQueueV1.json"
  ],
  "objective": "Prepare the entire game warehouse and Blender/material source queues in organized cloud-safe batches while P1C01 remains the only runtime activation target.",
  "runner_boundary": {
    "allowed_now": [
      "source catalogs",
      "material kit manifests",
      "Blender QC contracts",
      "SHA256 receipt reuse plans",
      "derived FBX/PNG/TGA/ORM staging specifications",
      "static validators and classifier tests"
    ],
    "blocked_until_self_hosted_runner_returns": [
      "UE4 import commandlets",
      "PIE traversal",
      "Windows cook/package",
      "target-device FPS",
      "visual acceptance",
      "Gate 6/7 claims"
    ]
  },
  "root_cause_fixes": [
    {
      "blocker": "Git terminal clone/credentials unavailable",
      "root_fix": "Use GitHub Connector read/write APIs for branches, commits, PRs and workflow evidence; do not stop production on terminal clone failure.",
      "guard": "Connector-written files plus PR #368 evidence"
    },
    {
      "blocker": "Self-hosted UE4 job queued by source-only metadata",
      "root_fix": "Classify cloud-first metadata, validators and tests as source/governance safe in Scripts/classify_unreal_validation.ps1.",
      "guard": "Scripts/test_unreal_classifier.ps1 cloud-first-shire-assembly case"
    },
    {
      "blocker": "Linux Blender failed because NumPy was missing",
      "root_fix": "Keep Blender readiness checks and python3-numpy dependency before conversion runs; fail before expensive Unreal.",
      "guard": "Blender readiness contract in prep batches"
    },
    {
      "blocker": "Binary FBX sources lacked LayerElementSmoothing",
      "root_fix": "Preserve originals; create derived FBX copies with normals/tangents/material slots and zero missing smoothing requirement.",
      "guard": "FBX static preflight before Unreal import"
    },
    {
      "blocker": "Degenerate faces risk during normalization",
      "root_fix": "Clean only derived meshes in Blender, preserve UVs/normals/material indices, and emit SHA256 receipts for originals and outputs.",
      "guard": "degenerate_faces_zero_or_repaired_derivative_only"
    },
    {
      "blocker": "Repeated full scans/builds slowed production",
      "root_fix": "Reuse unchanged SHA256 receipts and run validators only for changed queues/scripts until runtime evidence is needed.",
      "guard": "incremental_source_only_classifier"
    }
  ],
  "material_quality_contract": {
    "texture_sets": [
      "base_color",
      "normal",
      "orm_or_ao_roughness_metallic",
      "height_optional",
      "emissive_optional"
    ],
    "ue4_compatibility": [
      "PNG_or_TGA",
      "power_of_two_preferred",
      "linear_ORM",
      "sRGB_base_color_only",
      "material_slot_names_stable"
    ],
    "blender_qc": [
      "remove_degenerate_faces_on_derivatives",
      "preserve_uvs",
      "preserve_custom_normals",
      "preserve_material_slots",
      "export_binary_fbx"
    ],
    "unreal_import_contract": [
      "zero_missing_smoothing_groups",
      "material_slot_count_nonzero",
      "collision_strategy_declared",
      "LOD_or_cull_strategy_declared"
    ]
  },
