{
  "schema_version": 1,
  "plan_id": "PART1_NPC_CONVERSATION_CONTRACT_V1",
  "purpose": "Data-first contract for bounded NPC-to-NPC ambient conversations. Defines eligibility, intent categories, knowledge/story gating, cooldowns, repetition control and priority. Runtime playback is a separate implementation step.",
  "status_values": [
    "PLANNED",
    "DATA_DEFINED",
    "RUNTIME_PARTIAL",
    "RUNTIME_VALIDATED"
  ],
  "intent_types": [
    "GREETING",
    "WORK_TALK",
    "LOCAL_NEWS",
    "STORY_REACTION",
    "DANGER_WARNING",
    "TRAVEL_COMMENT",
    "COMPANION_BANTER",
    "FAREWELL",
    "SILENT_ACKNOWLEDGEMENT"
  ],
  "priority_levels": [
    "STORY_CRITICAL",
    "STORY_REACTIVE",
    "AMBIENT_HIGH",
    "AMBIENT_NORMAL",
    "AMBIENT_LOW"
  ],
  "speaker_rules": {
    "max_active_conversations_near_player": 2,
    "max_participants_per_conversation": 2,
    "minimum_player_distance_for_audible_ambient": 120,
    "maximum_player_distance_for_audible_ambient": 1200,
    "ambient_start_cooldown_seconds": 18,
    "same_pair_repeat_cooldown_seconds": 90,
    "same_intent_repeat_cooldown_seconds": 60,
    "story_critical_preempts_ambient": true,
    "danger_override_preempts_social": true,
    "allow_offscreen_simulation": false
  },
  "selection_rules": [
    "Both participants must resolve to valid NPCSocialModel profiles or ambient archetypes.",
    "Participants must share a current region and be within the runtime social-distance budget.",
    "Intent required_knowledge_tags must be a subset of each speaker's allowed knowledge when the speaker contributes a line.",
    "Required story beats/quest stages gate STORY_REACTION and DANGER_WARNING intents.",
    "A conversation cannot reveal future film-core outcomes or knowledge unavailable to either speaker.",
    "Named story NPCs may participate in ambient talk only when no story-critical interaction is active.",
    "Ambient archetypes use short low-cost exchanges and do not receive persistent individual memory.",
    "Conversation choice is deterministic from eligible intent IDs plus cooldown history; free runtime generation is not required.",
    "Dialogue text remains original project-authored content or bounded variation; screenplay text is not copied."
  ],
  "repetition_policy": {
    "remember_recent_intent_ids_per_named_npc": 6,
    "remember_recent_partner_ids_per_named_npc": 4,
    "ambient_archetype_history_scope": "LOCAL_SESSION",
    "named_npc_history_scope": "SAVE_OPTIONAL_FUTURE",
    "fallback_when_no_fresh_intent": "SILENT_ACKNOWLEDGEMENT"
  },
