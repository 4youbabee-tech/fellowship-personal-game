  "source_conflict_policy": {
    "film_scene_present": "Preserve film outcome, staging intent and canonical postconditions.",
    "film_silent": "Use Tolkien/project lore when it does not contradict locked film outcomes.",
    "gameplay_bridge": "Mark as DESIGN_ORIGINAL and keep canonical postconditions fixed.",
    "generated_or_external_visual": "Use as modeling aid only; never override project canon, character identity or mission state."
  },
  "external_resource_intake_policy": {
    "objective": "Keep production moving while laptop/Windows runner is offline by accepting useful lawful and technically repairable sources into source-only prep queues.",
    "required_receipt_fields": [
      "source_url_or_local_artifact",
      "creator_or_uploader",
      "license_or_personal_use_note",
      "original_filename",
      "download_or_capture_date",
      "sha256_original",
      "intended_use",
      "modifications",
      "derived_output_path"
    ],
    "license_tiers": [
      "GREEN-OPEN",
      "GREEN-LICENSED",
      "BLUE-PERSONAL",
      "YELLOW-PER-ASSET",
      "REFERENCE-ONLY",
      "QUARANTINE",
      "DISABLED"
    ],
    "personal_home_use_acceleration": "For non-commercial home use, reduce repeated administrative review after first receipt, but keep provenance and quarantine unclear franchise-specific assets.",
    "format_policy": {
      "static_meshes": "Convert useful sources into UE4.27-ready derived FBX without editing originals.",
      "skeletal_characters": "Skeletal FBX with skeleton, materials, LOD intent and retarget/deformation validation before runtime acceptance.",
      "textures": "PNG/TGA preferred; prepare ORM/channel-packed outputs where useful; avoid shipping oversized uncompressed sources.",
      "texture_budget": "Default 1K/2K for target 2GB VRAM; 4K only for measured hero assets; 8K/16K source downscale only."
    }
  },
